@{
    ViewData["Title"] = ViewBag.Nombre ?? "Sala";

    string mainRecurso = "";
    if (ViewBag.RecursoUrl != null)
    {
        mainRecurso = ViewBag.RecursoUrl;
    }

    string subRecurso = "";
    if (ViewBag.RecursoSubUrl != null)
    {
        subRecurso = ViewBag.RecursoSubUrl;
    }

    bool tieneFondo = ViewBag.Nivel != null && !string.IsNullOrEmpty(mainRecurso);
    string fondoStyle = "min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 20px; position: relative; background-color: rgba(0,0,0,0.4);";

    if (tieneFondo)
    {
        fondoStyle = "background-image: url('" + mainRecurso + "'); background-size: cover; background-position: center; min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 20px; position: relative;";
    }

    bool esFinal = ViewBag.Nivel == 6;
    if (esFinal && !string.IsNullOrEmpty(mainRecurso))
    {
        fondoStyle = "background-image: url('" + mainRecurso + "'); background-size: cover; background-position: center; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px; position: relative;";
    }
}

<div class="sala-container" style="@fondoStyle">
    <!-- Overlay oscuro para mejor legibilidad -->
    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.4);"></div>
    
   
    
    <div style="position: relative; z-index: 10; width: 100%; max-width: 900px;">
        
        <!-- Encabezado de la sala -->
        <div style="text-align: center; color: white; margin-bottom: 30px;">
            <h1 style="font-size: 2.5em; margin: 0; text-shadow: 2px 2px 5px rgba(0,0,0,0.7);">@ViewBag.Nombre</h1>
            @if(ViewBag.Nivel > 0 && ViewBag.Nivel < 6)
            {
                <p style="font-size: 1.2em; margin: 10px 0 0 0; opacity: 0.9;">Nivel @ViewBag.Nivel</p>
            }
        </div>

        <!-- Contenedor de pistas (lado izquierdo) -->
        @if (ViewBag.Nivel > 0 && ViewBag.Nivel < 6)
        {
            <div style="display: flex; gap: 40px; justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
                
                <section class="pistas-section" style="flex: 0 1 250px; background: rgba(0, 0, 0, 0.7); padding: 20px; border-radius: 10px; border-left: 4px solid #FFD700;">
                    <h3 style="color: #FFD700; margin-top: 0; text-align: center;">PISTAS</h3>
                    
                    <!-- Pista 1 -->
                    <div style="margin-bottom: 15px;">
                        <button id="btnPista1" class="btn-pista" onclick="mostrarPista(1)" style="width: 100%; padding: 10px; background-color: #FFD700; color: black; border: none; border-radius: 5px; font-weight: bold; cursor: pointer;">
                            🔍 Pista 1
                        </button>
                        <div id="contenidoPista1" style="display: none; margin-top: 10px; color: white; background: rgba(255,255,255,0.1); padding: 10px; border-radius: 5px; font-size: 0.9em; line-height: 1.5;">
                            @ViewBag.Pista1
                        </div>
                    </div>

                    <!-- Pista 2 (Deshabilitada hasta mostrar Pista 1) -->
                    <div style="margin-bottom: 15px;">
                        <button id="btnPista2" class="btn-pista" onclick="mostrarPista(2)" disabled style="width: 100%; padding: 10px; background-color: #999; color: white; border: none; border-radius: 5px; font-weight: bold; cursor: not-allowed;">
                            🔍 Pista 2
                        </button>
                        <div id="contenidoPista2" style="display: none; margin-top: 10px; color: white; background: rgba(255,255,255,0.1); padding: 10px; border-radius: 5px; font-size: 0.9em; line-height: 1.5;">
                            @ViewBag.Pista2
                        </div>
                    </div>

                    <!-- Pista 3 (Deshabilitada hasta mostrar Pista 2) -->
                    <div>
                        <button id="btnPista3" class="btn-pista" onclick="mostrarPista(3)" disabled style="width: 100%; padding: 10px; background-color: #999; color: white; border: none; border-radius: 5px; font-weight: bold; cursor: not-allowed;">
                            🔍 Pista 3
                        </button>
                        <div id="contenidoPista3" style="display: none; margin-top: 10px; color: white; background: rgba(255,255,255,0.1); padding: 10px; border-radius: 5px; font-size: 0.9em; line-height: 1.5;">
                            @ViewBag.Pista3
                        </div>
                    </div>
                </section>
            </div>
        }

            <!-- Contenedor principal de la sala (Centro) -->
            <div class="sala-contenido" style="flex: 1 1 350px; background: rgba(0, 0, 0, 0.8); padding: 40px; border-radius: 10px; border: 2px solid #FFD700;">
                
                <!-- Subfoto (si no es la primera ni última sala y tiene imagen secundaria) -->
                @if (ViewBag.Nivel >= 1 && ViewBag.Nivel < 6 && !string.IsNullOrEmpty(ViewBag.RecursoSubUrl))
                {
                    <div style="text-align: center; margin-bottom: 30px;">
                        <img src="@ViewBag.RecursoSubUrl" alt="Pista visual" style="max-width: 100%; max-height: 250px; border-radius: 8px; border: 2px solid #FFD700; box-shadow: 0 0 10px rgba(255,215,0,0.5);">
                    </div>
                }

                

                <!-- Formulario de respuesta -->
                @if (esFinal)
                {
                    <div style="text-align: center; color: #FFD700;">
                        <h2 style="font-size: 3em; margin: 0 0 20px 0; text-shadow: 2px 2px 5px rgba(0,0,0,0.7);">¡GANASTE! 🎉</h2>
                        <p style="font-size: 1.3em; margin: 0; opacity: 0.9;">¡Felicidades por completar la sala de escape!</p>
                    </div>

                    <div style="text-align: center; margin-top: 30px;">
                        <a asp-controller="Sala" asp-action="ReiniciarJuego"
                           style="display: inline-block; padding: 12px 24px; background-color: #28a745; color: white; border: none; border-radius: 5px; font-weight: bold; font-size: 1.1em; cursor: pointer; text-decoration: none; transition: background-color 0.3s; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
                            🔁 Volver a jugar
                        </a>
                    </div>
                }
                else
                {
                <!-- Contenedor de mensajes de error -->
                @if (TempData["MensajeError"] != null)
                {
                    <div style="background-color: #ff6b6b; color: white; padding: 12px; border-radius: 5px; margin-bottom: 15px; text-align: center; font-weight: bold;">
                        @TempData["MensajeError"]
                    </div>
                }
                else
                {
                    <div id="mensajeError" style="display: none; background-color: #ff6b6b; color: white; padding: 12px; border-radius: 5px; margin-bottom: 15px; text-align: center; font-weight: bold;">
                        ❌ Respuesta incorrecta. Intenta de nuevo.
                    </div>
                }
                
                @if(ViewBag.Nivel == 0) {
                    <h2 style="color: #FFFFFF; font-size: 1.8em; margin: 20px 0; text-align: center;">El recorrido de Forrest</h2>
                    <div style="color: #ffffff; font-size: 1.4em; margin-top: 10px; text-align: center;">
                    
                        <p>En tu viaje por este lugar, te vas a cruzar con muchos recuerdos. Algunas veces, las imágenes te pueden ayudar mucho. Miralas bien, porque una foto puede decir más de mil palabras... y tal vez te cuenten la historia de hacia dónde tenés que correr. Pero recordá que hasta los mejores corredores necesitan un respiro o alguien que les sople el viento a favor. Otras veces, puede ser que una pista sea indispensable para pasar el nivel. No te apures, pensá con calma y administralas sabiamente para pasar la sala de la mejor forma. Las pistas son como los milagros: aparecen cuando más las necesitás, pero no hay que gastarlas todas juntas.</p>
                        <p>No hay diferencias entre mayúsculas y minúsculas. Las respuestas <span style="font-weight: bold;">NUNCA</span> van con Espacio.</p>
                        <p>Al enviar tu nombre, comenzará la experiencia. ¡Buena suerte!</p>
                    </div>
                }

                else if(ViewBag.Nivel == 1) {
                    <div style="color: #FFD700; font-size: 1.4em; margin-top: 10px; text-align: center;">
                        <p>Jenny = 10 5 14 14 26</p>
                    </div>
                }

                else if(ViewBag.Nivel == 2) {
                    <div style="color: #FFD700; font-size: 1.4em; margin-top: 10px; text-align: center;">
                        <p>Sabés cuál es la bandera de este país? Forrest luchó en una famosa guerra en este lugar mientras ejercía su rol dentro del ejército.</p>
                    </div>
                }

                else if(ViewBag.Nivel == 3) {
                    <div style="color: #FFD700; font-size: 1.4em; margin-top: 10px; text-align: center;">
                        <p>La clave para ser bueno jugando al ping pong es mirar siempre a la pelota. Para eso hay que ___________</p>
                    </div>
                }

                else if(ViewBag.Nivel == 4) {
                    <div style="color: #FFD700; font-size: 1.4em; margin-top: 10px; text-align: center;">
                        <p>La clave para pasar a la siguiente sala es la clave en la vida de Forrest.</p>
                    </div>
                }

                else if(ViewBag.Nivel == 5) {
                    <div style="color: #FFD700; font-size: 1.4em; margin-top: 10px; text-align: center;">
                        <p>Una frase que le dice Forrest a su seguidor mientras corría está escrita en la foto y se debe escribir toda junta:</p>
                    </div>
                }

                <form id="formRespuesta" method="post" asp-controller="Sala" asp-action="Respuesta" style="display: flex; flex-direction: column; gap: 15px;">
                    
                    <div>
                        @if(ViewBag.Nivel == 0) {
                        <label for="respuesta" style="color: #FFD700; font-weight: bold; display: block; margin-bottom: 8px; font-size: 1.2em;">Su nombre en esta experiencia:</label>
                        <input type="text" id="respuesta" name="respuesta" required placeholder="Escribe aquí..." style="width: 100%; padding: 12px; border: 2px solid #FFD700; border-radius: 5px; background-color: rgba(255,255,255,0.9); font-size: 1em; box-sizing: border-box;">
                        }
                        else{
                        <label for="respuesta" style="color: #FFD700; font-weight: bold; display: block; margin-bottom: 8px; font-size: 1.2em;">Tu Respuesta:</label>
                        <input type="text" id="respuesta" name="respuesta" required placeholder="Escribe aquí..." style="width: 100%; padding: 12px; border: 2px solid #FFD700; border-radius: 5px; background-color: rgba(255,255,255,0.9); font-size: 1em; box-sizing: border-box;">
                        }
                        
                    </div>

                    <button type="submit" class="btn-enviar" style="padding: 12px; background-color: #28a745; color: white; border: none; border-radius: 5px; font-weight: bold; font-size: 1.1em; cursor: pointer; transition: background-color 0.3s;">
                        Enviar Respuesta
                    </button>
                    
                </form>
                }

                <input type="hidden" id="hiddenRespuestaCorrecta" value="@ViewBag.RespuestaCorrecta">
                <input type="hidden" id="hiddenNivel" value="@ViewBag.Nivel">
                <input type="hidden" id="hiddenIdSala" value="@ViewBag.Id">
            </div>
        </div>
    </div>
</div>




